# CompBench AI - Environment Configuration
# Instructions: Copy this file to .env and configure your environment settings.
# Example: cp .env.example .env (or in PowerShell: Copy-Item .env.example .env)

# Environment Mode: Set to 'production' in production deployments to enforce strict TLS and security checks
ENVIRONMENT=development

# Google Gemini API Key (Get yours at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model configuration (Defaults to gemini-2.5-flash)
# Supported options: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# =========================================================
# Authentication & Session Security Configuration
# Quick Setup: Run 'python setup_admin.py' to securely configure your admin account.
# =========================================================

# Secret key used for signing cryptographic HMAC-SHA256 session tokens.
# REQUIRED in production. Configured automatically by setup_admin.py, or manually generate via:
# python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET_KEY=your_secure_random_auth_secret_key_here

# Administrator Account Provisioning (Authorized enterprise user)
# REQUIRED in production. Configured automatically by setup_admin.py.
ADMIN_EMAIL=admin@compbench.ai

# Administrator Argon2 Password Hash (OWASP recommended; do not store plaintext).
# REQUIRED in production. Configured automatically by setup_admin.py, or manually generate via:
# python -c "from argon2 import PasswordHasher; ph = PasswordHasher(time_cost=2, memory_cost=4096, parallelism=1); print(ph.hash('YourStrongPasswordHere'))"
ADMIN_PASSWORD_HASH=your_argon2_password_hash_here

# Session duration in hours before re-authentication is required (Default: 8)
SESSION_DURATION_HOURS=8

# Allowed CORS Origins (Comma-separated list of origins for cross-domain deployments)
# e.g., https://compbench-ai.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# =========================================================
# Database Configuration (MySQL 8.0+ / PyMySQL) - Phase 1
# =========================================================
# Option A: Direct database connection URL (recommended)
# DATABASE_URL=mysql+pymysql://compbench_user:your_mysql_password@localhost:3306/compbench_db?charset=utf8mb4

# Option B: Discrete connection variables
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=compbench_user
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=compbench_db

# Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600

# =========================================================
# Resend Transactional Email Service - Phase 2
# =========================================================
# Resend API Key (starts with 're_')
# Get yours at https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# Verified Sender Email Address (e.g., CompBench AI <onboarding@resend.dev> or your verified domain)
RESEND_FROM_EMAIL=CompBench AI <onboarding@resend.dev>

# Application Base URL for generating email verification and password reset links
APP_BASE_URL=http://localhost:8000
