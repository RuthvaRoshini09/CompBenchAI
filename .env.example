# CompBench AI - Environment Configuration
# Instructions: Copy this file to .env and insert your Google Gemini API key.
# Example: cp .env.example .env (or in PowerShell: Copy-Item .env.example .env)

# Google Gemini API Key (Get yours at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model configuration (Defaults to gemini-2.5-flash)
# Supported options: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash
